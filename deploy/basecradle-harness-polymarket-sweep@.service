# BaseCradle Harness — polymarket_paper deterministic sweep (per-agent template unit).
#
# Authored here by the harness captain; **deployed and finalized by the NOC** (the fleet's
# sole deployer — paths, the venv location, hardening, and the cadence in the .timer are the
# NOC's to tune). One instance per agent that has the `polymarket_paper` stem opted in:
#   systemctl enable --now basecradle-harness-polymarket-sweep@jt.timer
#
# What it does: settles markets that public state now reports resolved, fills resting limit
# orders the book has crossed, and refreshes mark-to-market prices — writing only to the
# agent's append-only paper ledger under $HARNESS_HOME/polymarket.
#
# **It never calls a model and never wakes the agent** (issue #347, NORMATIVE §A3). The
# module it runs imports no provider and no BaseCradle client, so there is nothing in it
# that could; the agent discovers fills and settlements on its next own pull. That is also
# why this unit needs **no BASECRADLE_TOKEN and no AI_API_KEY** — it reaches two public,
# read-only Polymarket endpoints over plain HTTPS GETs and nothing else.

[Unit]
Description=BaseCradle Harness — polymarket_paper ledger sweep for agent %i
Documentation=https://github.com/basecradle/basecradle-harness/issues/347
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=%i
Group=%i

# Only HARNESS_HOME is actually read here (the ledger's location). The agent's env file is
# the same one the wake/install use; secrets in it are read literally by systemd, never
# shell-sourced — and this job needs none of them.
EnvironmentFile=/home/%i/.config/basecradle/agent.env

# The installed console-script in the agent's venv (e.g. /home/jt/venv). NOC-tunable.
ExecStart=/home/%i/venv/bin/basecradle-harness-polymarket-sweep

# Sandboxing — the sweep reads two public HTTPS endpoints and appends to files under
# $HARNESS_HOME. It needs no new privileges, no shell, and writes nowhere else.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=false
ReadWritePaths=/home/%i
PrivateTmp=true
ProtectControlGroups=true
ProtectKernelModules=true
RestrictRealtime=true
