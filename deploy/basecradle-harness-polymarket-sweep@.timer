# BaseCradle Harness — polymarket_paper sweep schedule (per-agent template timer).
#
# Drives `basecradle-harness-polymarket-sweep@%i.service` **hourly**. Unlike the cleanup
# timer's cadence, this one is not merely a suggestion: the resting-limit re-check policy is
# "hourly sweep plus on any agent tool call touching that market", and that choice is frozen
# into each epoch's `epoch_open` ledger row (issue #347, NORMATIVE §2.4). Changing the cadence
# changes the simulation's semantics mid-epoch, so move it at an epoch boundary, not casually.
#
#   systemctl enable --now basecradle-harness-polymarket-sweep@jt.timer

[Unit]
Description=Run the BaseCradle Harness polymarket_paper ledger sweep for agent %i (hourly)
Documentation=https://github.com/basecradle/basecradle-harness/issues/347

[Timer]
OnBootSec=15min
OnUnitActiveSec=1h
# Catch up one missed run after downtime rather than skipping an hour of resolutions.
Persistent=true
# Stagger agents that share a box so they don't all hit the public endpoints at one instant
# (the shared-IP rate-limit-floor discipline).
RandomizedDelaySec=5min

[Install]
WantedBy=timers.target
